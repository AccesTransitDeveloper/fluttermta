<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- ServerConfig's "local" environment points at a plain-http LAN address
         (http://<ip>:5000). Android 9+ blocks cleartext by default, so those
         requests fail before they leave the device and the app hangs on splash
         waiting for get_token.

         Debug-only on purpose: release builds keep cleartext blocked, so this
         cannot weaken a shipped app. -->
    <application android:usesCleartextTraffic="true" />
</manifest>
