diff --git a/artifacts/api-server/src/services/mta/matchingPolicy.ts b/artifacts/api-server/src/services/mta/matchingPolicy.ts
new file mode 100644
index 0000000..078b6b9
--- /dev/null
+++ b/artifacts/api-server/src/services/mta/matchingPolicy.ts
@@ -0,0 +1,13 @@
+/** Automatic MTA dispatch uses straight-line miles from pickup to driver. */
+export const DEFAULT_MATCH_RADIUS_MILES = 2;
+
+export function isWithinMatchingRadius(
+  distanceMiles: number,
+  radiusMiles: number = DEFAULT_MATCH_RADIUS_MILES,
+): boolean {
+  return Number.isFinite(distanceMiles)
+    && distanceMiles >= 0
+    && Number.isFinite(radiusMiles)
+    && radiusMiles > 0
+    && distanceMiles <= radiusMiles;
+}
