diff --git a/artifacts/api-server/test/driverAuth.test.ts b/artifacts/api-server/test/driverAuth.test.ts
new file mode 100644
index 0000000..094a2c1
--- /dev/null
+++ b/artifacts/api-server/test/driverAuth.test.ts
@@ -0,0 +1,98 @@
+import assert from "node:assert/strict";
+import { createServer } from "node:http";
+import { test } from "node:test";
+import app from "../src/app.js";
+
+const localFetch = globalThis.fetch.bind(globalThis);
+
+test("driver-app routes use Core bearer auth while admin driver routes require a session", async () => {
+  const server = createServer(app);
+  await new Promise<void>((resolve, reject) => {
+    server.once("error", reject);
+    server.listen(0, "127.0.0.1", resolve);
+  });
+
+  const originalFetch = globalThis.fetch;
+  const coreRequests: Array<{ url: string; authorization: string | undefined }> = [];
+  let coreStatus = 401;
+
+  try {
+    const address = server.address();
+    assert.ok(address && typeof address !== "string");
+    const baseUrl = `http://127.0.0.1:${address.port}`;
+
+    globalThis.fetch = (async (input, init) => {
+      const url = new URL(input instanceof Request ? input.url : String(input));
+      coreRequests.push({
+        url: url.toString(),
+        authorization: new Headers(init?.headers).get("authorization") ?? undefined,
+      });
+      return new Response("{}", { status: coreStatus });
+    }) as typeof fetch;
+
+    const driverRoutes = [
+      { method: "POST", path: "/api/mta/driver-app/consent" },
+      { method: "GET", path: "/api/mta/driver-app/status" },
+      { method: "POST", path: "/api/mta/driver-app/location" },
+      { method: "GET", path: "/api/mta/driver-app/offers" },
+      { method: "POST", path: "/api/mta/driver-app/offers/123/accept" },
+      { method: "POST", path: "/api/mta/driver-app/offers/123/reject" },
+    ];
+
+    for (const route of driverRoutes) {
+      const response = await localFetch(`${baseUrl}${route.path}`, {
+        method: route.method,
+        headers: { connection: "close" },
+      });
+      const body = await response.json() as { error?: string };
+
+      assert.equal(response.status, 401, `${route.method} ${route.path}`);
+      assert.equal(body.error, "A Core bearer token is required");
+      assert.notEqual(body.error, "Unauthorized — please log in");
+    }
+    assert.equal(coreRequests.length, 0, "missing bearer requests must not contact Core");
+
+    const adminResponse = await localFetch(`${baseUrl}/api/mta/drivers`, {
+      headers: { connection: "close" },
+    });
+    const adminBody = await adminResponse.json() as { error?: string };
+    assert.equal(adminResponse.status, 401);
+    assert.equal(adminBody.error, "Unauthorized — please log in");
+    assert.equal(coreRequests.length, 0, "admin routes must not contact Core");
+
+    for (const scenario of [
+      {
+        upstreamStatus: 401,
+        expectedStatus: 401,
+        expectedError: "Core authentication could not verify this driver",
+      },
+      {
+        upstreamStatus: 521,
+        expectedStatus: 503,
+        expectedError: "Core authentication could not verify this driver",
+      },
+    ]) {
+      coreStatus = scenario.upstreamStatus;
+      const response = await localFetch(`${baseUrl}/api/mta/driver-app/status`, {
+        headers: {
+          authorization: "Bearer deliberately-invalid-test-token",
+          connection: "close",
+        },
+      });
+      const body = await response.json() as { error?: string };
+
+      assert.equal(response.status, scenario.expectedStatus);
+      assert.equal(body.error, scenario.expectedError);
+      assert.notEqual(body.error, "Unauthorized — please log in");
+      assert.equal(coreRequests.at(-1)?.authorization, "Bearer deliberately-invalid-test-token");
+      assert.equal(new URL(coreRequests.at(-1)!.url).pathname, "/api/auth/get_entity_detail");
+    }
+    assert.equal(coreRequests.length, 2, "each bearer verification should make only the Core detail request");
+  } finally {
+    globalThis.fetch = originalFetch;
+    await new Promise<void>((resolve, reject) => {
+      server.close((error) => error ? reject(error) : resolve());
+      server.closeAllConnections();
+    });
+  }
+});
