new file mode 100644
index 0000000..067e0e6
--- /dev/null
+++ b/artifacts/api-server/test/matchingPolicy.test.ts
@@ -0,0 +1,41 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { FindNearbyDriversBody } from "@workspace/api-zod";
+import { haversineDistanceMiles } from "../src/services/mta/haversine.js";
+import {
+  DEFAULT_MATCH_RADIUS_MILES,
+  isWithinMatchingRadius,
+} from "../src/services/mta/matchingPolicy.js";
+
+test("automatic matching includes 2 miles but excludes anything further away", () => {
+  assert.equal(DEFAULT_MATCH_RADIUS_MILES, 2);
+  for (const distance of [0, 1, 1.999, 2]) {
+    assert.equal(isWithinMatchingRadius(distance), true);
+  }
+  for (const distance of [2.000001, 2.10, 2.39, 3, NaN, Infinity, -1]) {
+    assert.equal(isWithinMatchingRadius(distance), false);
+  }
+});
+
+test("distance remains in miles and uses the pickup-to-driver straight-line distance", () => {
+  assert.equal(haversineDistanceMiles(40.7, -73.9, 40.7, -73.9), 0);
+  const latitudeOffsetForMiles = (miles: number) =>
+    (miles / 3958.8) * (180 / Math.PI);
+  assert.equal(isWithinMatchingRadius(
+    haversineDistanceMiles(0, 0, latitudeOffsetForMiles(1.99), 0),
+  ), true);
+  assert.equal(isWithinMatchingRadius(
+    haversineDistanceMiles(0, 0, latitudeOffsetForMiles(2.01), 0),
+  ), false);
+});
+
+test("admin nearby-search schema defaults to the same 2 miles", () => {
+  const input = FindNearbyDriversBody.parse({ lat: 40.7, lng: -73.9 });
+  assert.equal(input.radius_miles, DEFAULT_MATCH_RADIUS_MILES);
+  assert.equal(FindNearbyDriversBody.safeParse({
+    lat: 40.7, lng: -73.9, radius_miles: 0,
+  }).success, false);
+  assert.equal(FindNearbyDriversBody.safeParse({
+    lat: 40.7, lng: -73.9, radius_miles: -1,
+  }).success, false);
+});
