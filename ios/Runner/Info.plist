<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>GoogleMapsAPIKey</key>
	<string>$(GOOGLE_MAPS_API_KEY)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>AT Driver — Drive &amp; Earn NYC</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>AT Driver</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.639704789203-quh13ikke4n9uig3ln0ssg60op56ab2o</string>
				<string>com.accessible.provider</string>
			</array>
		</dict>
	</array>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>tel</string>
		<string>https</string>
		<string>http</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!-- Location -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>This app needs access to your location to provide accurate navigation and pickup/drop-off tracking.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>This app needs access to your location to provide accurate navigation and live location updates while on a trip.</string>
	<!-- Camera -->
	<key>NSCameraUsageDescription</key>
	<string>This app needs camera access to capture document photos and profile pictures.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>AT AI Driver uses the microphone only while voice input is active to capture your answer.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>AT AI Driver converts your spoken registration answers into text while voice input is active.</string>
	<!-- Photos -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>This app needs photo library access to select document images and profile pictures.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>This app needs photo library access to save captured photos.</string>
	<!-- Contacts -->
	<key>NSContactsUsageDescription</key>
	<string>This app needs access to your contacts for emergency contact features.</string>
	<!-- Declares the app only uses exempt encryption (standard HTTPS/TLS).
	     Without this, every upload waits on the export-compliance question in
	     App Store Connect before TestFlight can process the build. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
